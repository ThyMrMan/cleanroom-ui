+	bool IDDB::has(std::uint64_t a_id) const noexcept
+	{
+		if (std::to_underlying(m_format) < 5) {
+			const MAPPING elem{ a_id, 0 };
+			const auto    it = std::lower_bound(m_v0.begin(), m_v0.end(), elem, [](auto&& a_lhs, auto&& a_rhs) {
+                return a_lhs.id < a_rhs.id;
+            });
+			return it != m_v0.end() && it->id == a_id;
+		}
+		return a_id < m_v5.size() && m_v5[a_id] != 0;
+	}
+
 	std::uint64_t IDDB::offset(std::uint64_t a_id) const
 	{
 		const auto mod = REX::FModule::GetExecutingModule();
